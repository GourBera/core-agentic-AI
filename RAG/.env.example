# Production-Grade RAG Configuration
# 7-Layer Architecture with Pinecone + Ollama

# ============================================
# Layer 3b: Pinecone Vector Database
# ============================================
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=prod
PINECONE_INDEX_NAME=rag-production

# ============================================
# Layer 7: Ollama Local LLM
# ============================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ============================================
# Layer 3a: Embedding Model
# ============================================
EMBEDDING_DEVICE=cuda

# ============================================
# Logging & Monitoring
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Data Paths
# ============================================
RAG_DATA_DIR=./data
RAG_CACHE_DIR=./cache

# ============================================
# Performance
# ============================================
BATCH_SIZE=32
CACHE_TTL=3600

# ============================================
# Access Control
# ============================================
ENABLE_ACCESS_CONTROL=true


# LLM Settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Embedding Settings
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
